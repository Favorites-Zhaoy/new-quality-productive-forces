 "cases": [
  {
   "date": "2025-09",
   "title": "工信部、民政部公布32个智能养老服务机器人结对攻关与场景应用试点项目",
   "entity": "工业和信息化部、民政部；海尔机器人、京东科技、新松机器人、国家康复辅具研究中心等牵头单位",
   "summary": "两部门2025年5月启动试点（试点期2025—2027年），面向居家、社区、机构三类养老形态，围绕失能失智照护、情感陪护、健康促进等场景遴选32个项目；要求居家类产品完成不少于200户家庭验证、社区/机构类不少于20个社区或20家机构验证，验证周期不少于6个月。",
   "figures": [
    {
     "label": "入围项目",
     "value": "32个"
    },
    {
     "label": "居家类验证要求",
     "value": "≥200户、部署≥200台套"
    },
    {
     "label": "社区/机构类验证要求",
     "value": "≥20个社区或20家机构、部署≥20台套"
    },
    {
     "label": "应用验证周期",
     "value": "≥6个月"
    }
   ],
   "source": "新华网 2025-06-10；工信部公示名单PDF",
   "url": "https://www.news.cn/tech/20250610/075b8c4008794364bae8a63c3550810f/c.html"
  },
  {
   "date": "2025-05",
   "title": "从照料起居到情感陪伴：养老机器人进社区、进机构",
   "entity": "西安第一爱心护理院、乌镇智能养老中心、唐山开平区社区、上海彩虹湾老年福利院等",
   "summary": "新华社调查显示，外骨骼机器人帮助68岁瘫痪患者恢复行走，乌镇智能养老中心用送餐机器人把餐盒送到失能老人房门口，唐山开平区为300余户老人安装远程呼叫器与智能网关；89岁老人在福利院学习使用DeepSeek。",
   "figures": [
    {
     "label": "唐山开平区智能监测覆盖",
     "value": "300余户老人"
    },
    {
     "label": "2024年国内养老机器人市场规模（报道引述）",
     "value": "突破300亿元"
    },
    {
     "label": "AI人机互动养老机器人价格",
     "value": "超过14万元"
    },
    {
     "label": "助浴机器人均价",
     "value": "3万至5万元"
    }
   ],
   "source": "新华网《从照料起居到情感陪伴 养老机器人温暖幸福晚年》2025-05-06",
   "url": "https://www.news.cn/tech/20250506/d1a8becc114f4ee58cb060f20cbf25d6/c.html"
  },
  {
   "date": "2025-12",
   "title": "中国品牌包揽全球家用清洁机器人出货前五",
   "entity": "石头科技、科沃斯、追觅、小米、云鲸",
   "summary": "据IDC，2025年全球家用清洁机器人出货3272万台、同比增长20.1%，前五均为中国厂商，合计份额约54.5%；家政清洁成为AI+视觉导航落地最成熟的居民服务场景之一。",
   "figures": [
    {
     "label": "全球出货",
